{
  "plugin": {
    "key": "koropwnz/stab-r2d2-plugin",
    "name": "StabX та термінал R2D2",
    "description": "Відкриває сервіси Raspberry Pi Zero модуля StabX через мережевий канал R2D2 та надає захищену токеном командну консоль для діагностики Raspberry Pi R2D2. Локальні адреси оператора: 18080, 15050 і 18081.",
    "type": "docker",
    "icon": "Router",
    "helpLink": "https://github.com/KORO-GIT/stab-r2d2-plugin/releases/tag/v0.2.7",
    "registry": "registry-1.docker.io",
    "status": "test",
    "published": true
  },
  "versions": [
    {
      "version": "0.2.7",
      "url": "https://github.com/KORO-GIT/stab-r2d2-plugin/releases/download/v0.2.7/stabh-r2d2-plugin-0.2.7.tgz",
      "description": "Два веб-проксі StabX і захищена токеном командна консоль Raspberry Pi R2D2 через штатний Інтернет-канал.",
      "whatsNew": "Додано підтвердження доставки ACK для кожного фрагмента веб-відповіді та термінала. Наступний фрагмент надсилається лише після підтвердження від наземної станції.",
      "configSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "TARGET_HOSTS": {
            "type": "string",
            "title": "Адреси StabX",
            "default": "pizero2,pizero2.local"
          },
          "AUTO_DISCOVER": {
            "type": "boolean",
            "title": "Автоматично знаходити IP StabX",
            "default": true
          },
          "DISCOVERY_INTERVAL": {
            "type": "number",
            "title": "Інтервал повторного пошуку, секунд",
            "minimum": 10,
            "maximum": 600,
            "default": 60
          },
          "TARGET_PORT": {
            "type": "integer",
            "title": "Порт StabX",
            "minimum": 1,
            "maximum": 65535,
            "default": 8080
          },
          "LISTEN_PORT": {
            "type": "integer",
            "title": "Порт на R2D2",
            "minimum": 1024,
            "maximum": 65535,
            "default": 18080
          },
          "SECONDARY_TARGET_PORT": {
            "type": "integer",
            "title": "Другий порт StabX",
            "minimum": 1,
            "maximum": 65535,
            "default": 5050
          },
          "SECONDARY_LISTEN_PORT": {
            "type": "integer",
            "title": "Другий порт на R2D2",
            "minimum": 1024,
            "maximum": 65535,
            "default": 15050
          },
          "REMOTE_TUNNEL_ENABLED": {
            "type": "boolean",
            "title": "Доступ через Інтернет-канал R2D2",
            "default": true
          },
          "REMOTE_MAX_RESPONSE_BYTES": {
            "type": "integer",
            "title": "Ліміт однієї відповіді через Інтернет, байт",
            "minimum": 65536,
            "maximum": 16777216,
            "default": 4194304
          },
          "TERMINAL_ENABLED": {
            "type": "boolean",
            "title": "Увімкнути захищений термінал R2D2",
            "default": false
          },
          "TERMINAL_TOKEN": {
            "type": "string",
            "title": "Секретний токен термінала",
            "default": ""
          },
          "TERMINAL_TIMEOUT": {
            "type": "number",
            "title": "Таймаут команди термінала, секунд",
            "minimum": 1,
            "maximum": 60,
            "default": 20
          },
          "TERMINAL_MAX_OUTPUT_BYTES": {
            "type": "integer",
            "title": "Ліміт виводу однієї команди, байт",
            "minimum": 4096,
            "maximum": 524288,
            "default": 262144
          },
          "PROXY_USERNAME": {
            "type": "string",
            "title": "Логін проксі",
            "default": ""
          },
          "PROXY_PASSWORD": {
            "type": "string",
            "title": "Пароль проксі",
            "default": ""
          },
          "CONNECT_TIMEOUT": {
            "type": "number",
            "title": "Таймаут з'єднання, секунд",
            "minimum": 0.5,
            "maximum": 30,
            "default": 5.0
          },
          "REWRITE_ABSOLUTE_URLS": {
            "type": "boolean",
            "title": "Переписувати абсолютні посилання StabX",
            "default": true
          }
        },
        "required": [
          "TARGET_HOSTS",
          "AUTO_DISCOVER",
          "TARGET_PORT",
          "LISTEN_PORT",
          "SECONDARY_TARGET_PORT",
          "SECONDARY_LISTEN_PORT"
        ]
      },
      "uiSchema": {
        "ui:order": [
          "TARGET_HOSTS",
          "AUTO_DISCOVER",
          "TARGET_PORT",
          "LISTEN_PORT",
          "SECONDARY_TARGET_PORT",
          "SECONDARY_LISTEN_PORT",
          "REMOTE_TUNNEL_ENABLED",
          "REMOTE_MAX_RESPONSE_BYTES",
          "TERMINAL_ENABLED",
          "TERMINAL_TOKEN",
          "TERMINAL_TIMEOUT",
          "TERMINAL_MAX_OUTPUT_BYTES",
          "PROXY_USERNAME",
          "PROXY_PASSWORD",
          "CONNECT_TIMEOUT",
          "DISCOVERY_INTERVAL",
          "REWRITE_ABSOLUTE_URLS"
        ],
        "TARGET_HOSTS": {
          "ui:help": "Плагін перевіряє адреси зліва направо. Якщо імена не визначаються, вкажіть IP Raspberry Pi Zero."
        },
        "AUTO_DISCOVER": {
          "ui:help": "Якщо ім'я pizero2 не визначається, плагін шукає StabX у DHCP/ARP та локальних /24 мережах."
        },
        "LISTEN_PORT": {
          "ui:help": "Вебінтерфейс буде доступний на цьому TCP-порту IP-адреси R2D2."
        },
        "SECONDARY_LISTEN_PORT": {
          "ui:help": "Сервіс StabX на порту 5050 буде доступний на цьому TCP-порту IP-адреси R2D2."
        },
        "REMOTE_TUNNEL_ENABLED": {
          "ui:help": "Передає браузерні запити через plugin.ctl, коли наземна станція підключена до борту через Інтернет."
        },
        "REMOTE_MAX_RESPONSE_BYTES": {
          "ui:advanced": true,
          "ui:help": "Захисний ліміт для сторінок і файлів. Відеопотоки через цей канал блокуються."
        },
        "TERMINAL_ENABLED": {
          "ui:help": "Термінал працює тільки через авторизований канал R2D2 і додатково вимагає секретний токен. Увімкніть лише на час діагностики."
        },
        "TERMINAL_TOKEN": {
          "ui:widget": "password",
          "ui:help": "Не менше 24 символів. Токен не надсилається у командах: використовується підпис HMAC-SHA256."
        },
        "TERMINAL_TIMEOUT": {
          "ui:advanced": true
        },
        "TERMINAL_MAX_OUTPUT_BYTES": {
          "ui:advanced": true
        },
        "PROXY_USERNAME": {
          "ui:help": "Залиште порожнім лише в ізольованій мережі. Якщо логін задано, браузер запросить логін і пароль."
        },
        "PROXY_PASSWORD": {
          "ui:widget": "password"
        },
        "CONNECT_TIMEOUT": {
          "ui:advanced": true
        },
        "DISCOVERY_INTERVAL": {
          "ui:advanced": true
        },
        "REWRITE_ABSOLUTE_URLS": {
          "ui:advanced": true
        }
      },
      "defaultConfig": {
        "TARGET_HOSTS": "pizero2,pizero2.local",
        "AUTO_DISCOVER": true,
        "TARGET_PORT": 8080,
        "LISTEN_PORT": 18080,
        "SECONDARY_TARGET_PORT": 5050,
        "SECONDARY_LISTEN_PORT": 15050,
        "REMOTE_TUNNEL_ENABLED": true,
        "REMOTE_MAX_RESPONSE_BYTES": 4194304,
        "TERMINAL_ENABLED": false,
        "TERMINAL_TOKEN": "",
        "TERMINAL_TIMEOUT": 20,
        "TERMINAL_MAX_OUTPUT_BYTES": 262144,
        "PROXY_USERNAME": "",
        "PROXY_PASSWORD": "",
        "CONNECT_TIMEOUT": 5.0,
        "DISCOVERY_INTERVAL": 60,
        "REWRITE_ABSOLUTE_URLS": true
      },
      "presets": [],
      "published": true,
      "deprecated": false
    }
  ]
}
